GEO_DOMAIN=geo.example.com
GEO_ADMIN_EMAIL=admin@example.com
GEO_CAPTURE_CONCURRENCY=2

# local: shared Docker volume; s3: S3/MinIO/COS compatible private bucket
GEO_OBJECT_STORE=local
GEO_S3_ENDPOINT=
GEO_S3_REGION=auto
GEO_S3_BUCKET=
GEO_S3_ACCESS_KEY_ID=
GEO_S3_SECRET_ACCESS_KEY=
GEO_S3_FORCE_PATH_STYLE=false
