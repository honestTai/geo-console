{
  "$schema": "https://turborepo.dev/schema.json",
	"globalEnv": ["DATABASE_URL", "GEO_DATA_DIR", "GEO_WORKER_HOST", "GEO_WORKER_PORT", "GEO_LOCAL_COMBINED", "GEO_LOG_SERVICE_URL", "GEO_LOG_SERVICE_TOKEN", "GEO_LOG_SERVICE_TOKEN_FILE", "GEO_LOG_RETENTION_DAYS", "DEEPSEEK_API_KEY", "DEEPSEEK_MODEL", "DEEPSEEK_BASE_URL"],
  "tasks": {
    "//#format": {
      "cache": false
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "check-types"],
      "outputs": [".output/**", ".vercel/output/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
