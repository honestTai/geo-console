:80 {
	root * /srv
	encode zstd gzip
	@sourceDownloads path /source /source/*
	redir @sourceDownloads https://github.com/honestTai/geo-console/releases/tag/v0.1.0 302
	@llmAlias path /llm.txt
	redir @llmAlias /llms.txt 308
	@homeIndex path /index.html
	redir @homeIndex / 308
	@helpIndex path /help/index.html
	redir @helpIndex /help/ 308
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"
	@nonSearch path /app /app/* /interactive/* /source/* /desktop/* /demo.html
	header @nonSearch X-Robots-Tag "noindex"
	handle_path /interactive/* {
		root * /srv/interactive
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-cache"
		file_server
	}
	@appExact path /app
	redir @appExact /app/ 308
	handle_path /app/* {
		root * /srv/app
		header X-Content-Type-Options nosniff
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable" {
				match status 2xx 304
			}
			file_server
		}
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
	@helpExact path /help
	redir @helpExact /help/ 308
	handle_path /help/* {
		root * /srv/help
		file_server
	}
	handle {
		file_server
	}
}
