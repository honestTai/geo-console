:80 {
	root * /srv
	encode zstd gzip
	@appExact path /app
	redir @appExact /app/ 308
	handle_path /app/* {
		root * /srv/app
		header X-Content-Type-Options nosniff
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable" {
				match status 2xx 304
			}
			file_server
		}
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
	@helpExact path /help
	redir @helpExact /help/ 308
	handle_path /help/* {
		root * /srv/help
		try_files {path} /index.html
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
