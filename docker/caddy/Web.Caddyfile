:80 {
	root * /srv
	encode zstd gzip
	@appExact path /app
	redir @appExact /app/ 308
	handle_path /app/* {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
	@helpExact path /help
	redir @helpExact /help/ 308
	handle_path /help/* {
		root * /srv/help
		try_files {path} /index.html
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
