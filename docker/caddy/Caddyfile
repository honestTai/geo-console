{$GEO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	handle /api/* {
		reverse_proxy api:3010
	}
	handle /artifacts/* {
		reverse_proxy api:3010
	}
	handle /share/* {
		reverse_proxy api:3010
	}
	handle {
		reverse_proxy web:80
	}
}
