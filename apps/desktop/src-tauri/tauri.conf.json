{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "ZZ Geo",
	"version": "0.2.0",
	"identifier": "com.zzgeo.desktop",
	"build": {
		"frontendDist": "../../web/dist",
		"beforeDevCommand": "corepack pnpm --workspace-root geo start",
		"beforeBuildCommand": "corepack pnpm --filter @geo/web build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://www.honesttai.com http://127.0.0.1:3010"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"minimumSystemVersion": "12.0"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMzA5QTREMEVGOTFFRTkKUldUcEh2a09UWm93WEpUYnBXTVdYcVdSdHlFU0lITENkU24rUW8yOTM0aktQNEdweG13U1pXakwK",
			"endpoints": ["https://www.honesttai.com/desktop/latest.json"]
		}
	}
}
